# Obligatoria para generar explicaciones con OpenAI. Sin ella se usa una respuesta local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20

# Recomendado en una API pública. El cliente debe enviarla en X-API-Key.
APP_API_KEY=

# Lista separada por comas. Déjala vacía si no existe un frontend web.
CORS_ORIGINS=

MODEL_PATH=kfold.joblib
LOG_LEVEL=INFO
